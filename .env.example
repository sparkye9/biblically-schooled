# Real accounts (see README for the one-time setup steps)
#
# 1. In the Vercel dashboard: Project -> Storage -> Create Database -> Postgres.
#    Vercel injects DATABASE_URL / POSTGRES_URL automatically once attached —
#    no need to copy these manually.
#
# 2. Generate a secret and add it in Vercel: Project -> Settings ->
#    Environment Variables -> AUTH_SECRET. Generate one with:
#      npx auth secret
#    or:
#      node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=

# Auto-injected by Vercel once a Postgres database is attached — leave blank
# locally unless you're pointing at your own database for development.
DATABASE_URL=
